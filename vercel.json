{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "node scripts/vercel-build.cjs",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "ebhumi-platform/**",
      "excludeFiles": "ebhumi-platform/{.data,tests}/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
